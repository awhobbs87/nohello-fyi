{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "build/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "options": {
    "denyWarnings": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["**/*.astro"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
