<button
  class="preference-toggle office-toggle"
  type="button"
  data-office-toggle
  aria-label="The Office UK. Switch to The Office US"
  title="The Office UK"
>
  <span class="office-toggle__flag" data-office-flag aria-hidden="true">🇬🇧</span
  >
  <span data-office-label>The Office UK</span>
</button>

<script>
  type Office = 'uk' | 'us';

  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-office-toggle]',
  );
  const flags: Record<Office, string> = { uk: '🇬🇧', us: '🇺🇸' };
  const labels: Record<Office, string> = {
    uk: 'The Office UK',
    us: 'The Office US',
  };

  function getOffice(): Office {
    return document.documentElement.dataset.office === 'us' ? 'us' : 'uk';
  }

  function updateToggle(office: Office) {
    if (toggle == null) return;

    const label = labels[office];
    const nextOffice: Office = office === 'uk' ? 'us' : 'uk';
    toggle.querySelector<HTMLElement>('[data-office-label]')!.textContent =
      label;
    toggle.querySelector<HTMLElement>('[data-office-flag]')!.textContent =
      flags[office];
    toggle.ariaLabel = `${label}. Switch to ${labels[nextOffice]}`;
    toggle.title = label;
  }

  updateToggle(getOffice());

  toggle?.addEventListener('click', () => {
    const nextOffice: Office = getOffice() === 'uk' ? 'us' : 'uk';
    document.documentElement.dataset.office = nextOffice;
    localStorage.setItem('office', nextOffice);
    updateToggle(nextOffice);
  });
</script>
