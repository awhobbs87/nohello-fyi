{
  "name": "nohello-fyi",
  "description": "Please don't say just hello in chat",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awhobbs87/nohello-fyi.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "astro dev --port 8123",
    "serve": "astro dev --port 8123",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview --port 8123",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "format": "oxfmt --ignore-path .oxfmtignore . && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check . && prettier --check \"src/**/*.astro\"",
    "lint": "pnpm format:check && pnpm lint:oxlint && pnpm typecheck",
    "lint:oxlint": "oxlint .",
    "precommit": "pnpm lint",
    "prepare": "simple-git-hooks",
    "test": "pnpm test:unit && pnpm test:ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "pnpm build && playwright test",
    "test:ui:update": "pnpm build && playwright test --update-snapshots",
    "typecheck": "astro check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm precommit"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "astro": "7.2.9",
    "cookie": "2.0.1",
    "gettext-parser": "9.1.1",
    "marked": "18.0.11",
    "typed.js": "3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/gettext-parser": "9.0.0",
    "@types/node": "24.13.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "serve": "14.2.6",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
